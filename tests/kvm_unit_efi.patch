diff --git a/lib/x86/smp.c b/lib/x86/smp.c
index 0cd44cd..410f003 100644
--- a/lib/x86/smp.c
+++ b/lib/x86/smp.c
@@ -11,6 +11,7 @@
 #include "desc.h"
 #include "alloc_page.h"
 #include "asm/page.h"
+#include "acpi.h"
 
 #define IPI_VECTOR 0x20
 
@@ -39,6 +40,51 @@ extern u8 stacktop;
 atomic_t cpu_online_count = { .counter = 1 };
 unsigned char online_cpus[(MAX_TEST_CPUS + 7) / 8];
 
+#ifdef CONFIG_EFI
+struct efi_madt_local_apic {
+	struct acpi_subtable_header header;
+	u8 processorId;
+	u8 apicId;
+	u32 flags;
+} __attribute__((packed));
+
+struct efi_madt_local_x2apic {
+	struct acpi_subtable_header header;
+	u16 reserved;
+	u32 x2ApicId;
+	u32 flags;
+	u32 uid;
+} __attribute__((packed));
+
+static int efiProcessorCount;
+
+static int countEfiLocalApic(struct acpi_subtable_header *header)
+{
+	struct efi_madt_local_apic *entry = (void *)header;
+
+	if ((entry->flags & ACPI_MADT_ENABLED) && entry->apicId < MAX_TEST_CPUS)
+		efiProcessorCount++;
+	return 0;
+}
+
+static int countEfiLocalX2Apic(struct acpi_subtable_header *header)
+{
+	struct efi_madt_local_x2apic *entry = (void *)header;
+
+	if ((entry->flags & ACPI_MADT_ENABLED) && entry->x2ApicId < MAX_TEST_CPUS)
+		efiProcessorCount++;
+	return 0;
+}
+
+static int efiProcessorCountFromMadt(void)
+{
+	efiProcessorCount = 0;
+	acpi_table_parse_madt(ACPI_MADT_TYPE_LOCAL_APIC, countEfiLocalApic);
+	acpi_table_parse_madt(ACPI_MADT_TYPE_LOCAL_X2APIC, countEfiLocalX2Apic);
+	return efiProcessorCount;
+}
+#endif
+
 static __attribute__((used)) void ipi(void)
 {
 	void (*function)(void *data) = ipi_function;
@@ -292,7 +338,12 @@ void bringup_aps(void)
 	/* SIPI */
 	apic_icr_write(APIC_DEST_ALLBUT | APIC_DEST_PHYSICAL | APIC_DM_STARTUP, 0);
 
+#ifdef CONFIG_EFI
+	_cpu_count = efiProcessorCountFromMadt();
+#else
 	_cpu_count = fwcfg_get_nb_cpus();
+#endif
+	assert(_cpu_count > 0);
 
 	printf("smp: waiting for %d APs\n", _cpu_count - 1);
 	while (_cpu_count != atomic_read(&cpu_online_count))
