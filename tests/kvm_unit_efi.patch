 	 */
 	status = efi_get_system_config_table(ACPI_TABLE_GUID, (void **)&rsdp);
+	if (status != EFI_SUCCESS)
+		status = efi_get_system_config_table(ACPI_20_TABLE_GUID,
+					     (void **)&rsdp);
 	if (status != EFI_SUCCESS) {
 		return status;
 	}
