diff --git a/lib/x86/setup.c b/lib/x86/setup.c
index c2f1c6d..eccb0b3 100644
--- a/lib/x86/setup.c
+++ b/lib/x86/setup.c
@@ -212,6 +212,7 @@ static efi_status_t setup_memory_allocator(efi_bootinfo_t *efi_bootinfo)
 	int i;
 	unsigned long free_mem_pages = 0;
 	unsigned long free_mem_start = 0;
+	const u64 identityMapEnd = 1ULL << 32;
 	struct efi_boot_memmap *map = &(efi_bootinfo->mem_map);
 	efi_memory_desc_t *buffer = *map->map;
 	efi_memory_desc_t *d = NULL;
@@ -224,10 +225,17 @@ static efi_status_t setup_memory_allocator(efi_bootinfo_t *efi_bootinfo)
 	 * largest free continuous memory region.
 	 */
 	for (i = 0; i < *(map->map_size); i += *(map->desc_size)) {
+		u64 regionEnd;
+		u64 regionPages;
+
 		d = (efi_memory_desc_t *)(&((u8 *)buffer)[i]);
-		if (d->type == EFI_CONVENTIONAL_MEMORY) {
-			if (free_mem_pages < d->num_pages) {
-				free_mem_pages = d->num_pages;
+		if (d->type == EFI_CONVENTIONAL_MEMORY && d->phys_addr < identityMapEnd) {
+			regionEnd = d->phys_addr + (d->num_pages << EFI_PAGE_SHIFT);
+			if (regionEnd > identityMapEnd)
+				regionEnd = identityMapEnd;
+			regionPages = (regionEnd - d->phys_addr) >> EFI_PAGE_SHIFT;
+			if (free_mem_pages < regionPages) {
+				free_mem_pages = regionPages;
 				free_mem_start = d->phys_addr;
 			}
 		}
@@ -254,6 +262,9 @@ static efi_status_t setup_rsdp(efi_bootinfo_t *efi_bootinfo)
